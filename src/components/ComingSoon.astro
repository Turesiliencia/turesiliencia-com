---
import { Font, Image } from "astro:assets";
import AmazonIcon from "./AmazonIcon.astro";
import LogoEmblem from "./LogoEmblem.astro";
import cover from "../assets/sobrevivir-no-es-reconstruirse.jpg";
import "../styles/global.css";

// The coming-soon page, shown at / and for every unknown address (404), so
// links to the old site's posts and pages still reach her contact details and
// the book. Contact and book links are the same as on turesiliencia.org.
const title = "Deissy Olarte · TuResiliencia";
const description =
  "Estoy preparando mi nueva web. Mientras tanto, puedes escribirme, seguirme en Instagram o conseguir mi libro, «Sobrevivir no es reconstruirse».";
const email = "turesiliencia.com@gmail.com";
const instagram = {
  handle: "@turesiliencia_",
  url: "https://www.instagram.com/turesiliencia_",
};
const book = {
  title: "Sobrevivir no es reconstruirse",
  // The paperback. amazon.com is for readers in Latin America, who have no
  // Amazon store of their own.
  amazonUrl: "https://www.amazon.es/dp/B0HQ1SSMKB",
  otherStoreUrl: "https://www.amazon.com/dp/B0HQ1SSMKB",
};
const association = "https://www.turesiliencia.org";

const socialImage = new URL("/social-card-book.png", Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <meta name="theme-color" content="#050d1f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="TuResiliencia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Logotipo de TuResiliencia y portada del libro «${book.title}», de Deissy Olarte`} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-cormorant" preload />
    <Font cssVariable="--font-montserrat" preload />
  </head>
  <body>
    <main class="page">
      <section class="intro">
        <LogoEmblem class="emblem" />
        <p class="eyebrow">Deissy Olarte · TuResiliencia</p>
        <h1>Mi nueva web <em>está en camino.</em></h1>
        <p class="lede">
          Estoy preparando un nuevo espacio para compartir mi trabajo y mi blog.
          Mientras tanto, puedes escribirme o encontrarme en Instagram.
        </p>
        <ul class="contact">
          <li>
            <span class="label">Correo</span>
            <a href={`mailto:${email}`}>{email}</a>
          </li>
          <li>
            <span class="label">Instagram</span>
            <a href={instagram.url} rel="noopener">{instagram.handle}</a>
          </li>
        </ul>
      </section>

      <section class="book" aria-labelledby="book-title">
        <Image
          class="cover"
          src={cover}
          alt={`Portada del libro «${book.title}», de Deissy Olarte`}
          widths={[240, 360, 480, 720]}
          sizes="(min-width: 60rem) 15rem, 11rem"
          loading="eager"
        />
        <div class="book-text">
          <p class="eyebrow">Mi libro</p>
          <h2 id="book-title">{book.title}</h2>
          <a class="buy" href={book.amazonUrl} rel="noopener">
            <AmazonIcon class="buy-icon" />
            Comprar en Amazon
          </a>
          <p class="other-store">
            ¿Estás en Latinoamérica?{" "}
            <a href={book.otherStoreUrl} rel="noopener">Cómpralo en Amazon.com</a>
          </p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>
        Conoce también la{" "}
        <a href={association}>Asociación TuResiliencia</a>
      </p>
      <p>© 2026 Deissy Olarte</p>
    </footer>
  </body>
</html>

<style>
  .page {
    display: grid;
    gap: clamp(3rem, 8vw, 5rem);
    align-items: center;
    width: min(100%, 68rem);
    min-height: calc(100dvh - 5rem);
    margin-inline: auto;
    padding: clamp(3rem, 10vh, 6rem) var(--gutter) 3rem;
  }

  @media (min-width: 60rem) {
    .page {
      grid-template-columns: 1.25fr 1fr;
    }
  }

  /* The SVGs are rendered by child components, outside this page's scope. */
  :global(.emblem) {
    width: 4.5rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    color: var(--gold-300);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    font-weight: 500;
    line-height: 1.02;
    text-wrap: balance;
  }

  h1 em {
    display: block;
    color: var(--gold-300);
    font-style: italic;
  }

  .lede {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--mist);
    font-size: 1.0625rem;
    text-wrap: pretty;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .contact li {
    display: grid;
    gap: 0.25rem;
  }

  .label {
    color: var(--mist);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .contact a {
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--rule-strong);
    transition: border-color 0.2s, color 0.2s;
  }

  .contact a:hover {
    color: var(--gold-300);
    border-color: var(--gold-300);
  }

  .book {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: linear-gradient(160deg, var(--navy-900), var(--navy-950));
  }

  @media (min-width: 60rem) {
    .book {
      grid-template-columns: 1fr;
      justify-items: center;
      padding: 2.5rem 2rem;
      text-align: center;
    }
  }

  @media (max-width: 26rem) {
    .book {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }

  .cover {
    width: 100%;
    max-width: 15rem;
    height: auto;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.45);
  }

  @media (max-width: 26rem) {
    .cover {
      max-width: 11rem;
    }
  }

  .book-text {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  @media (min-width: 60rem), (max-width: 26rem) {
    .book-text {
      justify-items: center;
    }
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3vw, 2rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.1;
    text-wrap: balance;
  }

  .buy {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin-top: 0.5rem;
    padding: 0.8rem 1.4rem;
    color: var(--navy-950);
    background: var(--gold-300);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.2s;
  }

  .buy:hover {
    background: var(--cream);
  }

  :global(.buy-icon) {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
  }

  .other-store {
    color: var(--mist);
    font-size: 0.8125rem;
  }

  .other-store a {
    color: var(--cream);
    border-bottom: 1px solid var(--rule-strong);
  }

  .other-store a:hover {
    color: var(--gold-300);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    /* As wide as the content above it, so the rule lines up. */
    width: calc(min(100%, 68rem) - 2 * var(--gutter));
    margin-inline: auto;
    padding: 1.5rem 0 2rem;
    color: var(--mist);
    font-size: 0.8125rem;
    border-top: 1px solid var(--rule);
  }

  .footer a {
    color: var(--cream);
    border-bottom: 1px solid var(--rule-strong);
  }

  .footer a:hover {
    color: var(--gold-300);
  }
</style>
