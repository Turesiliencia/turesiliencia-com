---
// The book, as on turesiliencia.org: cover, title, a few lines from her own
// presentation of it (published with the launch post), and the Amazon links.
import { Image } from "astro:assets";
import AmazonIcon from "./AmazonIcon.astro";
import cover from "../assets/sobrevivir-no-es-reconstruirse.jpg";
import { book } from "../content/site";

interface Props {
  id?: string;
  // On the home page the label is the section's heading; under a post it is not.
  headingLevel?: "h2" | "p";
}
const { id, headingLevel = "h2" } = Astro.props;
const Label = headingLevel;
---

<section id={id} class="book section" aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="inner">
    <Image
      class="cover"
      src={cover}
      alt={`Portada del libro «${book.title}», de ${book.author}`}
      widths={[240, 360, 480, 640]}
      sizes="(min-width: 52rem) 18rem, 14rem"
    />
    <div class="text">
      <Label id={id ? `${id}-title` : undefined} class="label">Mi libro</Label>
      <p class="book-title"><cite>{book.title}</cite></p>
      <p class="lead">
        Después de una pérdida, todo el mundo pregunta cómo seguir adelante. Casi nadie pregunta qué le
        ocurre realmente a la persona que lo intenta.
      </p>
      <p class="body-text">
        <cite>{book.title}</cite> no es un manual de superación ni una guía para «sentirse bien». Es una
        invitación a mirar de frente lo que el duelo transforma por dentro: la identidad, el cuerpo, los
        vínculos, la dignidad y la propia idea de futuro.
      </p>
      <a class="button-primary buy" href={book.amazonUrl} rel="noopener">
        <AmazonIcon class="buy-icon" />
        Comprar en Amazon
      </a>
      <p class="other-store">
        ¿Estás en Latinoamérica? <a href={book.otherStoreUrl} rel="noopener">Cómpralo en Amazon.com</a>
      </p>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    justify-items: center;
    gap: 2.75rem;
    max-width: 62rem;
    margin-inline: auto;
  }

  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: 18rem 1fr;
      align-items: center;
      justify-items: stretch;
      gap: clamp(3rem, 6vw, 5rem);
    }
  }

  :global(.book .cover) {
    width: 100%;
    max-width: 14rem;
    height: auto;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.45);
  }

  @media (min-width: 52rem) {
    :global(.book .cover) {
      max-width: none;
    }
  }

  .text {
    max-width: 38rem;
  }

  .book-title cite {
    display: block;
    margin-top: 1.25rem;
    font: 600 clamp(2rem, 4.2vw, 3rem) / 1.08 var(--font-display);
    font-style: normal;
    letter-spacing: 0.02em;
    text-wrap: balance;
    color: var(--cream);
  }

  .lead {
    margin-top: 1.75rem;
    font: italic 500 1.5rem / 1.35 var(--font-display);
    text-wrap: pretty;
    color: var(--cream);
  }

  .body-text cite {
    font-style: italic;
    color: var(--cream);
  }

  .buy {
    flex-direction: row;
    align-items: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  :global(.buy-icon) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
  }

  .other-store {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--mist);
  }

  .other-store a {
    color: var(--gold-300);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .other-store a:hover {
    color: #e6cf9c;
  }
</style>
