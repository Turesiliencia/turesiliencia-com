---
import LogoEmblem from "./LogoEmblem.astro";
import { formatDate, imageAttrs, type PostSummary } from "../lib/sanity";

interface Props {
  post: PostSummary;
  headingLevel?: "h2" | "h3";
}
const { post, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const img = post.coverImage?.asset
  ? imageAttrs(post.coverImage, { widths: [400, 640, 960], ratio: 2 / 3 })
  : undefined;
---

<article class="card">
  <a href={`/${post.slug}/`} class="link">
    <div class="media">
      {
        img ? (
          <img
            src={img.src}
            srcset={img.srcset}
            sizes="(min-width: 68rem) 24rem, (min-width: 40rem) 50vw, 100vw"
            width={img.width}
            height={img.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          <LogoEmblem class="placeholder" id={`lotus-${post.slug}`} />
        )
      }
    </div>
    <p class="date"><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time></p>
    <Heading class="card-title">{post.title}</Heading>
  </a>
  <p class="excerpt">{post.excerpt}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .link {
    display: flex;
    flex-direction: column;
  }

  .media {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: linear-gradient(160deg, var(--paper-deep), var(--paper));
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  :global(.card .placeholder) {
    width: 30%;
    opacity: 0.8;
  }

  .link:hover img {
    transform: scale(1.03);
  }

  .date {
    margin-top: 1.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card-title {
    margin-top: 0.6rem;
    font: 600 1.6rem / 1.15 var(--font-display);
    text-wrap: balance;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .link:hover .card-title {
    color: var(--accent);
  }

  .excerpt {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .media img {
      transition: none;
    }

    .link:hover img {
      transform: none;
    }
  }
</style>
