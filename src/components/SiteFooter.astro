---
import LogoEmblem from "./LogoEmblem.astro";
import Monogram from "./Monogram.astro";
import { nav, site } from "../content/site";
---

<footer class="footer dark">
  <div class="inner">
    <div class="about">
      <a href="/" class="brand">
        <Monogram class="footer-monogram" />
        <span>{site.name}</span>
      </a>
      <p class="tagline">Reconstrucción Humana</p>
    </div>

    <nav aria-labelledby="footer-explore" class="column">
      <h2 id="footer-explore">Explora</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="column">
      <h2>Escríbeme</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.instagram.url} rel="noopener">Instagram {site.instagram.handle}</a></li>
      </ul>
    </div>

    <div class="column">
      <h2>La asociación</h2>
      <ul>
        <li>
          <a href={site.association.url} class="association">
            <LogoEmblem class="association-emblem" id="lotus-footer" />
            {site.association.name}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <p class="legal">© 2026 {site.name}</p>
</footer>

<style>
  /* Rounded at the top, like the panels, and in the book's green: the .org's
     footer is square and navy. */
  .footer {
    border-top: 1px solid var(--rule);
    border-radius: clamp(1.5rem, 3.5vw, 2.75rem) clamp(1.5rem, 3.5vw, 2.75rem) 0 0;
    background: var(--paper-deep);
  }

  .inner {
    display: grid;
    gap: 2.5rem;
    max-width: calc(76rem + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(3rem, 7vh, 4.5rem) var(--gutter) 2.5rem;
  }

  @media (min-width: 40rem) {
    .inner {
      grid-template-columns: repeat(3, 1fr);
    }

    .about {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: 1.7fr 1fr 1.4fr 1fr;
    }

    .about {
      grid-column: auto;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    font: 400 1.75rem / 1 var(--font-display);
    letter-spacing: -0.01em;
  }

  :global(.footer-monogram) {
    width: 3rem;
    font-size: 1.25rem;
  }

  /* The association's lotus, small, beside its name: the one place it
     appears here, as the link between the two sites. */
  .association {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  :global(.association-emblem) {
    flex: none;
    width: 1.6rem;
  }

  .tagline {
    margin-top: 1.25rem;
    font: italic 400 1.35rem / 1.3 var(--font-display);
    color: var(--ink);
  }

  .column h2 {
    font: italic 400 1.25rem / 1.3 var(--font-display);
    color: var(--accent);
  }

  .column ul {
    margin-top: 1rem;
    list-style: none;
  }

  .column li + li {
    margin-top: 0.55rem;
  }

  .column a {
    font-size: 0.875rem;
    color: var(--ink-soft);
    overflow-wrap: break-word;
    transition: color 0.2s ease;
  }

  .column a:hover {
    color: var(--ink);
  }

  .legal {
    width: calc(100% - 2 * var(--gutter));
    max-width: 76rem;
    margin-inline: auto;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
</style>
