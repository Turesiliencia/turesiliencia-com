---
import LogoEmblem from "./LogoEmblem.astro";
import { nav, site } from "../content/site";

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<header class="header">
  <div class="inner">
    <a href="/" class="brand">
      <LogoEmblem class="header-emblem" id="lotus-header" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Principal" class="nav">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === current ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--rule);
    background: rgb(247 244 236 / 0.88);
    backdrop-filter: blur(12px);
  }

  /* Phone: the name on the first row, the sections on the second. */
  .inner {
    display: grid;
    grid-template-areas:
      "brand"
      "nav";
    align-items: center;
    max-width: calc(76rem + 2 * var(--gutter));
    margin-inline: auto;
    padding: 0.6rem var(--gutter) 0;
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: auto 1fr;
      grid-template-areas: "brand nav";
      gap: 2rem;
      padding-block: 0.85rem;
    }
  }

  .brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    justify-self: start;
    color: var(--ink);
    font: 600 1.45rem / 1 var(--font-display);
    letter-spacing: 0.02em;
  }

  :global(.header-emblem) {
    width: 2.4rem;
  }

  .nav {
    grid-area: nav;
    margin-inline: calc(var(--gutter) * -1);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav ul {
    display: flex;
    justify-content: space-between;
    min-width: max-content;
    padding-inline: calc(var(--gutter) - 0.3rem);
    list-style: none;
  }

  @media (min-width: 48rem) {
    .nav {
      margin: 0;
    }

    .nav ul {
      justify-content: flex-end;
      gap: 0.5rem;
      padding: 0;
    }
  }

  .nav a {
    display: block;
    padding: 0.75rem 0.3rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }

  @media (min-width: 48rem) {
    .nav a {
      padding-inline: 0.8rem;
      font-size: 0.75rem;
      letter-spacing: 0.16em;
    }
  }

  .nav a:hover {
    color: var(--ink);
  }

  .nav a[aria-current="page"] {
    color: var(--accent);
  }
</style>
