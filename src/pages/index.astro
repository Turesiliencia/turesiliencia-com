---
import BookSection from "../components/BookSection.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { areas } from "../content/services";
import { site } from "../content/site";
import { getPosts } from "../lib/sanity";

const latest = (await getPosts()).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Deissy Olarte",
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  sameAs: [site.instagram.url, site.association.url],
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow label">TuResiliencia</p>
      <h1 class="headline">Deissy Olarte</h1>
      <p class="subtitle">Duelo migratorio, pérdida y transiciones vitales</p>
      <p class="lede">
        Acompaño a personas que atraviesan una pérdida, una migración o un cambio que lo altera todo, para
        que puedan volver a reconocerse. Aquí comparto también lo que escribo y mi libro.
      </p>
      <ul class="ctas">
        <li><a class="button-primary" href="/servicios/">Cómo te acompaño</a></li>
        <li><a class="button-secondary" href="/miblog/">Leer el blog</a></li>
      </ul>
    </div>
  </section>

  <section id="sobre-mi" class="about section" aria-labelledby="about-title">
    <div class="about-inner">
      <div>
        <p class="label">Sobre mí</p>
        <h2 id="about-title" class="title">Alguien que te escucha puede marcar la diferencia</h2>
        <p class="body-text">
          Soy Deissy Olarte. Quizá, como tú, he vivido momentos muy difíciles, y en ellos también busqué
          ayuda. No me arrepiento: esa experiencia me llevó a dedicarme a acompañar a otras personas.
        </p>
        <p class="body-text">
          Hoy me centro en el duelo migratorio, la pérdida y las transiciones vitales: esos cambios que nos
          obligan a preguntarnos quiénes somos y cuál es nuestro lugar. Soy también fundadora de la{" "}
          <a href={site.association.url}>{site.association.name}</a>.
        </p>
        <p class="more">
          <a class="arrow-link" href="/mihistoria/">
            Mi historia <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <dl class="pillars">
        <div>
          <dt>Formación</dt>
          <dd>
            Teóloga, con un máster en Psicología y Gestión Familiar por la Universidad de Valencia y otro en
            Atención a la Diversidad y Educación Inclusiva.
          </dd>
        </div>
        <div>
          <dt>Experiencia</dt>
          <dd>
            Más de diez años en la docencia universitaria, el coaching y el acompañamiento a personas en
            duelo.
          </dd>
        </div>
        <div>
          <dt>Reconocimiento</dt>
          <dd>Premio «Mujer Resiliente del Año 2025» de la Fundación Con Valores.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="servicios" class="services section" aria-labelledby="services-title">
    <div class="services-inner">
      <div>
        <p class="label">Cómo te acompaño</p>
        <h2 id="services-title" class="title">Sesiones online, desde cualquier lugar</h2>
        <p class="body-text">
          Acompaño en el duelo migratorio, el trauma y la pérdida, y también a familias y centros educativos.
          Las sesiones son por videoconferencia, individuales o en pareja, y ofrezco capacitaciones y talleres
          para grupos y empresas.
        </p>
        <ul class="ctas">
          <li><a class="button-primary" href="/servicios/">Servicios y tarifas</a></li>
          <li><a class="button-secondary" href="/servicios/#reservar">Reservar una sesión</a></li>
        </ul>
      </div>
      <ol class="areas">
        {
          areas.map((area, i) => (
            <li>
              <a href={`/servicios/#${area.id}`}>
                <span class="number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="area-title">{area.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section id="blog" class="blog section" aria-labelledby="blog-title">
        <div class="section-head">
          <p class="label">Mi blog</p>
          <h2 id="blog-title" class="title">Lo último que he escrito</h2>
        </div>
        <ul class="posts">
          {latest.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
        <p class="all">
          <a class="arrow-link" href="/miblog/">
            Todas las entradas <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>
    )
  }

  <BookSection id="libro" />

  <section id="contacto" class="contact section" aria-labelledby="contact-title">
    <p class="label">Contacto</p>
    <h2 id="contact-title">Escríbeme</h2>
    <p class="body-text">
      Si quieres reservar una sesión, contarme tu historia, preguntarme por el libro o proponerme una
      colaboración, puedes escribirme o encontrarme en Instagram.
    </p>
    <ul class="actions">
      <li>
        <a class="button-primary" href={`mailto:${site.email}`}>
          Correo
          <span>{site.email}</span>
        </a>
      </li>
      <li>
        <a class="button-secondary" href={site.instagram.url} rel="noopener">
          Instagram
          <span>{site.instagram.handle}</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Hero: hers, not the association's. The .org centres its lotus medallion
     over gold capitals; here the text is set to the left, her name in ink and
     in mixed case, over a quiet pattern: fine rings spreading like ripples
     around a lotus on water, off to the right, fading out before the text. */

  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(4rem, 12vh, 8rem) var(--gutter) clamp(5rem, 13vh, 8.5rem);
  }

  .hero::before {
    /* Where the rings spread from, how far they reach, and a second fade
       that keeps them out from behind the text. */
    --centre: 82% 45%;
    --reach: min(34rem, 40vw);
    --clear: linear-gradient(to right, transparent 38%, #000 68%);

    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-radial-gradient(
      circle at var(--centre),
      transparent 0 2.75rem,
      var(--rule-strong) 2.75rem calc(2.75rem + 1px),
      transparent calc(2.75rem + 1px) 2.875rem
    );
    -webkit-mask-image:
      radial-gradient(circle at var(--centre), #000 0, rgb(0 0 0 / 0.55) 40%, transparent var(--reach)),
      var(--clear);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(circle at var(--centre), #000 0, rgb(0 0 0 / 0.55) 40%, transparent var(--reach)),
      var(--clear);
    mask-composite: intersect;
    pointer-events: none;
  }

  /* On a phone the text takes the width: the rings move to the top right
     corner and fade out above the paragraph. */
  @media (max-width: 47.99rem) {
    .hero::before {
      --centre: 100% 0%;
      --reach: 18rem;
      --clear: linear-gradient(to bottom, #000 0, transparent 15rem);
    }
  }

  .hero-text {
    max-width: 76rem;
    margin-inline: auto;
  }

  .hero-text > * {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-text > :nth-child(2) { animation-delay: 0.08s; }
  .hero-text > :nth-child(3) { animation-delay: 0.2s; }
  .hero-text > :nth-child(4) { animation-delay: 0.3s; }
  .hero-text > :nth-child(5) { animation-delay: 0.42s; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .eyebrow::before {
    content: "";
    width: 2.5rem;
    height: 1px;
    background: var(--rule-strong);
  }

  .headline {
    margin-top: 1.25rem;
    font: 500 clamp(3.4rem, 8.5vw, 6.5rem) / 0.95 var(--font-display);
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .subtitle {
    max-width: 30ch;
    margin-top: 1.25rem;
    font: italic 500 clamp(1.45rem, 2.6vw, 2rem) / 1.25 var(--font-display);
    text-wrap: balance;
    color: var(--accent);
  }

  .lede {
    max-width: 52ch;
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    text-wrap: pretty;
    color: var(--ink-soft);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
    list-style: none;
  }

  /* About */

  .about-inner {
    display: grid;
    gap: 3rem;
    max-width: 76rem;
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .about-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }
  }

  .pillars {
    display: grid;
    gap: 1.75rem;
  }

  .pillars div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule-strong);
  }

  .pillars dt {
    font: italic 500 1.75rem / 1.1 var(--font-display);
    color: var(--accent);
  }

  .pillars dd {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--ink-soft);
  }

  .more {
    margin-top: 2rem;
  }

  /* Services */

  .services-inner {
    display: grid;
    gap: 3rem;
    max-width: 76rem;
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .services-inner {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
    }
  }

  .areas {
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  .areas a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .number {
    font: 600 0.75rem / 1 var(--font-sans);
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .area-title {
    font: italic 500 1.45rem / 1.2 var(--font-display);
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .areas a:hover .area-title {
    color: var(--accent);
  }

  .areas a:hover .arrow {
    transform: translateX(0.25rem);
  }

  /* Latest posts */

  .blog {
    background: var(--band);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .posts {
    display: grid;
    gap: 3rem clamp(1.5rem, 3vw, 2.75rem);
    max-width: 76rem;
    margin: clamp(2.5rem, 6vh, 3.75rem) auto 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .all {
    margin-top: 3rem;
    text-align: center;
  }

  /* Contact */

  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact h2 {
    margin-top: 1rem;
    font: italic 500 clamp(2rem, 4vw, 2.75rem) / 1.15 var(--font-display);
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.25rem;
    list-style: none;
  }

  .actions a {
    min-width: 15rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-text > * {
      animation: none;
    }

    .areas a:hover .arrow {
      transform: none;
    }
  }
</style>
