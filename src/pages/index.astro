---
import BookSection from "../components/BookSection.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { areas } from "../content/services";
import { book, site } from "../content/site";
import { talks } from "../content/talks";
import { getPosts } from "../lib/sanity";

const latest = (await getPosts()).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Deissy Olarte",
  url: Astro.site?.href,
  jobTitle: "Teóloga, investigadora y conferencista",
  knowsAbout: ["Reconstrucción Humana", "Duelo migratorio", "Transiciones vitales", "Resiliencia"],
  email: `mailto:${site.email}`,
  sameAs: [site.instagram.url],
  // The association is her own organisation, not another profile of hers.
  affiliation: { "@type": "Organization", name: site.association.name, url: site.association.url },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow label">Hola, soy</p>
      <h1 class="headline">Deissy Olarte</h1>
      <p class="subtitle">Teóloga, investigadora y conferencista internacional</p>
      <p class="lede">
        <strong>Reconstrucción Humana:</strong> pensamiento y herramientas para comprender las transiciones que
        transforman a las personas, las comunidades y las organizaciones.
      </p>
      <p class="lede bio">
        Colombiana migrante en España, autora de <em>{book.title}</em> y fundadora y presidenta de
        TuResiliencia.
      </p>
      <ul class="ctas">
        <li><a class="button-primary" href="/conferencias/#propuesta">Invítame a tu evento</a></li>
        <li><a class="button-secondary" href="/conferencias/">Conoce mis conferencias</a></li>
      </ul>
    </div>
  </section>

  <section id="conferencias" class="talks section panel" aria-labelledby="talks-title">
    <div class="split">
      <div>
        <p class="label">Conferencias</p>
        <h2 id="talks-title" class="title">Para congresos, universidades, empresas e instituciones</h2>
        <p class="body-text">
          Llevo la Reconstrucción Humana a encuentros de todo tipo, en conferencias, diálogos, mesas
          redondas y talleres, presenciales o en línea.
        </p>
        <ul class="ctas">
          <li><a class="button-primary" href="/conferencias/">Mis conferencias</a></li>
          <li><a class="button-secondary" href="/conferencias/#propuesta">Solicitar propuesta</a></li>
        </ul>
      </div>
      <ol class="areas">
        {
          talks.map((talk, i) => (
            <li>
              <a href={`/conferencias/#${talk.id}`}>
                <span class="number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="area-title">{talk.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="sobre-mi" class="about section" aria-labelledby="about-title">
    <div class="about-inner">
      <div>
        <p class="label">Sobre mí</p>
        <h2 id="about-title" class="title">Entre la teología, la docencia y el acompañamiento</h2>
        <p class="body-text">
          Investigo el duelo y la Reconstrucción Humana: lo que una pérdida, una migración o un cambio que lo
          altera todo transforma en una persona, y cómo puede volver a reconocerse. De esa investigación nace
          mi libro, <em>{book.title}</em>.
        </p>
        <p class="body-text">
          Soy colombiana y vivo en España. También he atravesado momentos muy difíciles, y en ellos busqué
          ayuda: esa experiencia da profundidad a lo que enseño y me llevó a acompañar a personas en España y
          en América Latina.
        </p>
        <p class="body-text">
          Soy fundadora y presidenta de la <a href={site.association.url}>{site.association.name}</a>, que
          lleva la Reconstrucción Humana a la formación, la investigación y la cooperación con universidades,
          empresas e instituciones.
        </p>
        <p class="signature">Deissy</p>
        <p class="more">
          <a class="arrow-link" href="/mihistoria/">
            Mi trayectoria <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <dl class="pillars">
        <div>
          <dt>Formación</dt>
          <dd>
            Teóloga, con un máster en Psicología y Gestión Familiar por la Universidad de Valencia y otro en
            Atención a la Diversidad y Educación Inclusiva.
          </dd>
        </div>
        <div>
          <dt>Experiencia</dt>
          <dd>
            Más de diez años en la docencia universitaria, el coaching y el acompañamiento a personas en
            duelo.
          </dd>
        </div>
        <div>
          <dt>Reconocimiento</dt>
          <dd>Premio «Mujer Resiliente del Año 2025» de la Fundación Con Valores.</dd>
        </div>
      </dl>
    </div>
  </section>

  <BookSection id="libro" />

  {
    latest.length > 0 && (
      <section id="blog" class="blog section" aria-labelledby="blog-title">
        <div class="section-head">
          <p class="label">Mi blog</p>
          <h2 id="blog-title" class="title">Lo último que he escrito</h2>
        </div>
        <ul class="posts">
          {latest.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
        <p class="all">
          <a class="arrow-link" href="/miblog/">
            Todas las entradas <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>
    )
  }

  <section id="acompanamiento" class="support section panel" aria-labelledby="support-title">
    <div class="split">
      <div>
        <p class="label">Acompañamiento</p>
        <h2 id="support-title" class="title">Si atraviesas una pérdida o un cambio, te acompaño</h2>
        <p class="body-text">
          Acompaño a personas que viven una migración, un duelo o una transición que lo altera todo, para que
          puedan volver a reconocerse. Las sesiones son por videoconferencia, individuales o en pareja, desde
          cualquier lugar.
        </p>
        <ul class="ctas">
          <li><a class="button-primary" href="/servicios/">Acompañamiento y tarifas</a></li>
          <li><a class="button-secondary" href="/servicios/#reservar">Reservar una sesión</a></li>
        </ul>
      </div>
      <ol class="areas">
        {
          areas.map((area, i) => (
            <li>
              <a href={`/servicios/#${area.id}`}>
                <span class="number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="area-title">{area.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="contacto" class="contact section" aria-labelledby="contact-title">
    <p class="label">Contacto</p>
    <h2 id="contact-title">Escríbeme</h2>
    <p class="body-text">
      Si organizas un congreso, una jornada o una formación, pídeme una propuesta. Si buscas acompañamiento,
      quieres preguntarme por el libro o proponerme una colaboración, escríbeme o encuéntrame en Instagram.
    </p>
    <ul class="actions">
      <li>
        <a class="button-primary" href={`mailto:${site.email}`}>
          Correo
          <span>{site.email}</span>
        </a>
      </li>
      <li>
        <a class="button-secondary" href={site.instagram.url} rel="noopener">
          Instagram
          <span>{site.instagram.handle}</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Hero: hers, not the association's. The .org opens on a navy band, its
     lotus medallion centred over gold capitals; here, on warm paper, she
     greets the visitor and the text is set to the left, her name in ink and
     in mixed case, over a quiet pattern: fine rings spreading like ripples
     around a lotus on water, off to the right, fading out before the text. */

  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(4rem, 12vh, 8rem) var(--gutter) clamp(5rem, 13vh, 8.5rem);
  }

  .hero::before {
    /* Where the rings spread from, how far they reach, and a second fade
       that keeps them out from behind the text. */
    --centre: 82% 45%;
    --reach: min(34rem, 40vw);
    --clear: linear-gradient(to right, transparent 38%, #000 68%);
    /* No rule under the hero: the rings fade out before its foot. */
    --foot: linear-gradient(to bottom, #000 70%, transparent);

    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-radial-gradient(
      circle at var(--centre),
      transparent 0 2.75rem,
      var(--rule-strong) 2.75rem calc(2.75rem + 1px),
      transparent calc(2.75rem + 1px) 2.875rem
    );
    -webkit-mask-image:
      radial-gradient(circle at var(--centre), #000 0, rgb(0 0 0 / 0.55) 40%, transparent var(--reach)),
      var(--clear),
      var(--foot);
    -webkit-mask-composite: source-in;
    mask-image:
      radial-gradient(circle at var(--centre), #000 0, rgb(0 0 0 / 0.55) 40%, transparent var(--reach)),
      var(--clear),
      var(--foot);
    mask-composite: intersect;
    pointer-events: none;
  }

  /* On a phone the text takes the width: the rings move to the top right
     corner and fade out above the paragraph. */
  @media (max-width: 47.99rem) {
    .hero::before {
      --centre: 100% 0%;
      --reach: 18rem;
      --clear: linear-gradient(to bottom, #000 0, transparent 15rem);
    }
  }

  .hero-text {
    max-width: 76rem;
    margin-inline: auto;
  }

  .hero-text > * {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-text > :nth-child(2) { animation-delay: 0.08s; }
  .hero-text > :nth-child(3) { animation-delay: 0.2s; }
  .hero-text > :nth-child(4) { animation-delay: 0.3s; }
  .hero-text > :nth-child(5) { animation-delay: 0.36s; }
  .hero-text > :nth-child(6) { animation-delay: 0.46s; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .eyebrow::before {
    content: "";
    width: 2.5rem;
    height: 1px;
    background: var(--rule-strong);
  }

  .headline {
    margin-top: 1.25rem;
    font: 500 clamp(3.4rem, 8.5vw, 6.5rem) / 0.95 var(--font-display);
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .subtitle {
    max-width: 30ch;
    margin-top: 1.25rem;
    font: italic 500 clamp(1.45rem, 2.6vw, 2rem) / 1.25 var(--font-display);
    text-wrap: balance;
    color: var(--accent);
  }

  .lede {
    max-width: 56ch;
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    text-wrap: pretty;
    color: var(--ink-soft);
  }

  .lede strong {
    font-weight: 600;
    color: var(--ink);
  }

  .bio {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
    list-style: none;
  }

  /* About */

  .about-inner {
    display: grid;
    gap: 3rem;
    max-width: 76rem;
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .about-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }
  }

  .pillars {
    display: grid;
    gap: 1.75rem;
  }

  /* Soft cards, where the .org draws ruled columns. */
  .pillars div {
    padding: 1.35rem 1.5rem 1.5rem;
    border-radius: 1rem;
    background: var(--paper-deep);
  }

  .pillars dt {
    font: italic 500 1.75rem / 1.1 var(--font-display);
    color: var(--accent);
  }

  .pillars dd {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--ink-soft);
  }

  /* Her name at the end of "Sobre mí", like a signature under a letter. */
  .signature {
    margin-top: 1.5rem;
    font: italic 500 2.75rem / 1 var(--font-display);
    color: var(--accent);
    transform: rotate(-3deg);
    transform-origin: left center;
  }

  .more {
    margin-top: 2rem;
  }

  /* Conferencias and Acompañamiento: text beside a numbered list. */

  .split {
    display: grid;
    gap: 3rem;
    max-width: 76rem;
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
    }
  }

  .areas {
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  .areas a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .number {
    font: 600 0.75rem / 1 var(--font-sans);
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .area-title {
    font: italic 500 1.45rem / 1.2 var(--font-display);
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .areas a:hover .area-title {
    color: var(--accent);
  }

  .areas a:hover .arrow {
    transform: translateX(0.25rem);
  }

  /* Latest posts */

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .posts {
    display: grid;
    gap: 3rem clamp(1.5rem, 3vw, 2.75rem);
    max-width: 76rem;
    margin: clamp(2.5rem, 6vh, 3.75rem) auto 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .all {
    margin-top: 3rem;
    text-align: center;
  }

  /* Contact */

  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact h2 {
    margin-top: 1rem;
    font: italic 500 clamp(2rem, 4vw, 2.75rem) / 1.15 var(--font-display);
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.25rem;
    list-style: none;
  }

  .actions a {
    min-width: 15rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-text > * {
      animation: none;
    }

    .areas a:hover .arrow {
      transform: none;
    }
  }
</style>
