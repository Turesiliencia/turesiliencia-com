---
import { Image } from "astro:assets";
import AmazonIcon from "../components/AmazonIcon.astro";
import BookSection from "../components/BookSection.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { areas } from "../content/services";
import { book, site } from "../content/site";
import { talks } from "../content/talks";
import { getPosts } from "../lib/sanity";
import { bookData, person, website } from "../lib/schema";
import cover from "../assets/sobrevivir-no-es-reconstruirse.jpg";

const latest = (await getPosts()).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [website(Astro.site), person(Astro.site), bookData(Astro.site)],
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow label">Hola, soy</p>
      <h1 class="headline"><span>Deissy</span> <em>Olarte</em></h1>
      <p class="subtitle">Teóloga, investigadora y conferencista internacional</p>
      <p class="lede">
        <strong>Reconstrucción Humana:</strong> pensamiento y herramientas para comprender las transiciones que
        transforman a las personas, las comunidades y las organizaciones.
      </p>
      <p class="lede bio">
        Colombiana migrante en España, autora de <em>{book.title}</em> y fundadora y presidenta de
        TuResiliencia.
      </p>
      <ul class="ctas">
        <li><a class="button-primary" href="/conferencias/#propuesta">Invítame a tu evento</a></li>
        <li><a class="button-secondary" href="/conferencias/">Conoce mis conferencias</a></li>
      </ul>
    </div>

    <div class="hero-art">
      <!-- The book is decoration: the text names it and its section follows. -->
      <div class="book3d" aria-hidden="true">
        <div class="book3d-body">
          <span class="book3d-back"></span>
          <span class="book3d-pages"></span>
          <Image
            class="hero-cover"
            src={cover}
            alt=""
            widths={[240, 360, 480, 640]}
            sizes="(min-width: 60rem) 16rem, 12rem"
            loading="eager"
          />
        </div>
      </div>
      <a class="store-badge" href={book.amazonUrl} rel="noopener">
        <AmazonIcon class="store-badge-icon" />
        <span><small>Disponible en</small> Amazon</span>
      </a>
    </div>
  </section>

  <section id="conferencias" class="talks section panel" aria-labelledby="talks-title">
    <div class="split">
      <div>
        <p class="label">Conferencias</p>
        <h2 id="talks-title" class="title">Para congresos, universidades, empresas e instituciones</h2>
        <p class="body-text">
          Llevo la Reconstrucción Humana a encuentros de todo tipo, en conferencias, diálogos, mesas
          redondas y talleres, presenciales o en línea.
        </p>
        <ul class="ctas">
          <li><a class="button-primary" href="/conferencias/">Mis conferencias</a></li>
          <li><a class="button-secondary" href="/conferencias/#propuesta">Solicitar propuesta</a></li>
        </ul>
      </div>
      <ol class="areas">
        {
          talks.map((talk, i) => (
            <li>
              <a href={`/conferencias/#${talk.id}`}>
                <span class="number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="area-title">{talk.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="sobre-mi" class="about section" aria-labelledby="about-title">
    <div class="about-inner">
      <div>
        <p class="label">Sobre mí</p>
        <h2 id="about-title" class="title">Entre la teología, la docencia y el acompañamiento</h2>
        <p class="body-text">
          Investigo el duelo y la Reconstrucción Humana: lo que una pérdida, una migración o un cambio que lo
          altera todo transforma en una persona, y cómo puede volver a reconocerse. De esa investigación nace
          mi libro, <em>{book.title}</em>.
        </p>
        <p class="body-text">
          Soy colombiana y vivo en España. También he atravesado momentos muy difíciles, y en ellos busqué
          ayuda: esa experiencia da profundidad a lo que enseño y me llevó a acompañar a personas en España y
          en América Latina.
        </p>
        <p class="body-text">
          Soy fundadora y presidenta de la <a href={site.association.url}>{site.association.name}</a>, que
          lleva la Reconstrucción Humana a la formación, la investigación y la cooperación con universidades,
          empresas e instituciones.
        </p>
        <p class="signature">Deissy</p>
        <p class="more">
          <a class="arrow-link" href="/mihistoria/">
            Mi trayectoria <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <dl class="pillars">
        <div>
          <dt>Formación</dt>
          <dd>
            Teóloga, con un máster en Psicología y Gestión Familiar por la Universidad de Valencia y otro en
            Atención a la Diversidad y Educación Inclusiva.
          </dd>
        </div>
        <div>
          <dt>Experiencia</dt>
          <dd>
            Más de diez años en la docencia universitaria, el coaching y el acompañamiento a personas en
            duelo.
          </dd>
        </div>
        <div>
          <dt>Reconocimiento</dt>
          <dd>Premio «Mujer Resiliente del Año 2025» de la Fundación Con Valores.</dd>
        </div>
      </dl>
    </div>
  </section>

  <BookSection id="libro" />

  {
    latest.length > 0 && (
      <section id="blog" class="blog section" aria-labelledby="blog-title">
        <div class="section-head">
          <p class="label">Mi blog</p>
          <h2 id="blog-title" class="title">Lo último que he escrito</h2>
        </div>
        <ul class="posts">
          {latest.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
        <p class="all">
          <a class="arrow-link" href="/miblog/">
            Todas las entradas <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>
    )
  }

  <section id="acompanamiento" class="support section panel" aria-labelledby="support-title">
    <div class="split">
      <div>
        <p class="label">Acompañamiento</p>
        <h2 id="support-title" class="title">Si atraviesas una pérdida o un cambio, te acompaño</h2>
        <p class="body-text">
          Acompaño a personas que viven una migración, un duelo o una transición que lo altera todo, para que
          puedan volver a reconocerse. Las sesiones son por videoconferencia, individuales o en pareja, desde
          cualquier lugar.
        </p>
        <ul class="ctas">
          <li><a class="button-primary" href="/servicios/">Acompañamiento y tarifas</a></li>
          <li><a class="button-secondary" href="/servicios/#reservar">Reservar una sesión</a></li>
        </ul>
      </div>
      <ol class="areas">
        {
          areas.map((area, i) => (
            <li>
              <a href={`/servicios/#${area.id}`}>
                <span class="number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="area-title">{area.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="contacto" class="contact section" aria-labelledby="contact-title">
    <p class="label">Contacto</p>
    <h2 id="contact-title">Escríbeme</h2>
    <p class="body-text">
      Si organizas un congreso, una jornada o una formación, pídeme una propuesta. Si buscas acompañamiento,
      quieres preguntarme por el libro o proponerme una colaboración, escríbeme o encuéntrame en Instagram.
    </p>
    <ul class="actions">
      <li>
        <a class="button-primary" href={`mailto:${site.email}`}>
          Correo
          <span>{site.email}</span>
        </a>
      </li>
      <li>
        <a class="button-secondary" href={site.instagram.url} rel="noopener">
          Instagram
          <span>{site.instagram.handle}</span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Hero: hers, not the association's. The .org opens on a navy band, its
     lotus medallion centred over gold capitals, square and symmetrical; here,
     on warm paper, she greets the visitor, her name set large on two lines,
     and beside it her book, standing on the page as a real paperback, with a
     store badge at its foot. */

  .hero {
    display: grid;
    gap: 3.5rem;
    max-width: calc(76rem + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(3.5rem, 10vh, 6.5rem) var(--gutter) clamp(4.5rem, 12vh, 7.5rem);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      align-items: center;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .hero-art {
    position: relative;
    width: min(13rem, 62%);
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .hero-art {
      width: 16rem;
      margin-right: clamp(0rem, 4vw, 4rem);
    }
  }

  /* The paperback standing on the page, turned a little to show its fore
     edge: the cover in front, the pages along its right side, the back
     behind, and its shadow on the paper. */
  .book3d {
    --thick: 1.6rem;

    position: relative;
    perspective: 1000px;
  }

  .book3d::after {
    content: "";
    position: absolute;
    left: 4%;
    right: -6%;
    bottom: -1.4rem;
    z-index: -1;
    height: 2.4rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--shadow), transparent);
    filter: blur(4px);
  }

  .book3d-body {
    position: relative;
    aspect-ratio: 2 / 3;
    transform-style: preserve-3d;
    transform: rotateY(-30deg) rotateX(2deg);
  }

  :global(.hero-cover),
  .book3d-back {
    position: absolute;
    inset: 0;
    border-radius: 0.15rem 0.3rem 0.3rem 0.15rem;
  }

  :global(.hero-cover) {
    width: 100%;
    height: 100%;
    transform: translateZ(calc(var(--thick) / 2));
    box-shadow: inset 0.35rem 0 0.4rem -0.2rem rgb(0 0 0 / 0.35);
  }

  .book3d-back {
    background: #323f34;
    transform: translateZ(calc(var(--thick) / -2));
    box-shadow: 1.5rem 1.5rem 2.5rem -0.5rem var(--shadow);
  }

  .book3d-pages {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: calc(100% - var(--thick) / 2);
    width: var(--thick);
    background:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 0.06) 0 1px, transparent 1px 3px),
      linear-gradient(90deg, #e8e0cc, #f6f1e4 50%, #e3dac4);
    transform: rotateY(90deg) translateZ(-0.12rem);
  }

  /* A store badge, black like Amazon's own, astride the book's foot; it
     fades in once the page has settled and goes to the paperback. */
  .store-badge {
    position: absolute;
    bottom: -2rem;
    left: -2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.05rem 0.55rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 0.6rem;
    background: #0f1111;
    box-shadow: 0 0.75rem 1.5rem -0.75rem rgb(0 0 0 / 0.5);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    animation: badge-in 0.9s 1.1s ease-out both;
    transition: background-color 0.2s ease;
  }

  .store-badge:hover {
    background: #232f3e;
  }

  .store-badge small {
    display: block;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    opacity: 0.85;
  }

  :global(.store-badge-icon) {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
  }

  @keyframes badge-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .store-badge {
      animation: none;
    }
  }

  .hero-text > * {
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-text > :nth-child(2) { animation-delay: 0.08s; }
  .hero-text > :nth-child(3) { animation-delay: 0.2s; }
  .hero-text > :nth-child(4) { animation-delay: 0.3s; }
  .hero-text > :nth-child(5) { animation-delay: 0.36s; }
  .hero-text > :nth-child(6) { animation-delay: 0.46s; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .eyebrow::before {
    content: "";
    width: 2.5rem;
    height: 1px;
    background: var(--rule-strong);
  }

  .headline {
    margin-top: 1.25rem;
    font: 400 clamp(3.6rem, 9.5vw, 7.25rem) / 0.92 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .headline span,
  .headline em {
    display: block;
  }

  /* Her surname in italic, set in from the left like a second hand. */
  .headline em {
    padding-left: 0.6em;
    font-style: italic;
    color: var(--accent);
  }

  .subtitle {
    max-width: 30ch;
    margin-top: 1.25rem;
    font: italic 400 clamp(1.45rem, 2.6vw, 2rem) / 1.25 var(--font-display);
    text-wrap: balance;
    color: var(--accent);
  }

  .lede {
    max-width: 56ch;
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    text-wrap: pretty;
    color: var(--ink-soft);
  }

  .lede strong {
    font-weight: 600;
    color: var(--ink);
  }

  .bio {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
    list-style: none;
  }

  /* About */

  .about-inner {
    display: grid;
    gap: 3rem;
    max-width: 76rem;
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .about-inner {
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }
  }

  .pillars {
    display: grid;
    gap: 1.75rem;
  }

  /* Soft cards, where the .org draws ruled columns. */
  .pillars div {
    padding: 1.35rem 1.5rem 1.5rem;
    border-radius: 1rem;
    background: var(--paper-deep);
  }

  .pillars dt {
    font: italic 400 1.75rem / 1.1 var(--font-display);
    color: var(--accent);
  }

  .pillars dd {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--ink-soft);
  }

  /* Her name at the end of "Sobre mí", like a signature under a letter. */
  .signature {
    margin-top: 1.5rem;
    font: italic 400 2.75rem / 1 var(--font-display);
    color: var(--accent);
    transform: rotate(-3deg);
    transform-origin: left center;
  }

  .more {
    margin-top: 2rem;
  }

  /* Conferencias and Acompañamiento: text beside a numbered list. */

  .split {
    display: grid;
    gap: 3rem;
    max-width: 76rem;
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
    }
  }

  .areas {
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  .areas a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .number {
    font: 600 0.75rem / 1 var(--font-sans);
    letter-spacing: 0.2em;
    color: var(--detail);
  }

  .area-title {
    font: italic 400 1.45rem / 1.2 var(--font-display);
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .areas a:hover .area-title {
    color: var(--accent);
  }

  .areas a:hover .arrow {
    transform: translateX(0.25rem);
  }

  /* Latest posts */

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .posts {
    display: grid;
    gap: 3rem clamp(1.5rem, 3vw, 2.75rem);
    max-width: 76rem;
    margin: clamp(2.5rem, 6vh, 3.75rem) auto 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .all {
    margin-top: 3rem;
    text-align: center;
  }

  /* Contact */

  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact h2 {
    margin-top: 1rem;
    font: italic 400 clamp(2rem, 4vw, 2.75rem) / 1.15 var(--font-display);
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.25rem;
    list-style: none;
  }

  .actions a {
    min-width: 15rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-text > * {
      animation: none;
    }

    .areas a:hover .arrow {
      transform: none;
    }
  }
</style>
