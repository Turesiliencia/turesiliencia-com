---
// Unknown addresses. The old site's Temarios, Tarifas and Tu videoconferencia
// redirect to /servicios/ instead (vercel.json).
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../content/site";
---

<BaseLayout title="Página no encontrada">
  <section class="not-found">
    <p class="label">Error 404</p>
    <h1 class="title">Esta página no existe</h1>
    <p class="body-text">
      Puede que la dirección haya cambiado con la nueva web. Desde aquí puedes leer mi blog, conocer mi
      libro o escribirme a <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
    <ul class="ctas">
      <li><a class="button-primary" href="/">Ir al inicio</a></li>
      <li><a class="button-secondary" href="/miblog/">Leer el blog</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(4rem, 14vh, 8rem) var(--gutter);
    text-align: center;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2.5rem;
    list-style: none;
  }
</style>
