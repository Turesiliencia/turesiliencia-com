---
// A post, at /<slug>/: the same address it had on the old site.
import BookSection from "../components/BookSection.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderBody } from "../lib/portable-text";
import { formatDate, getPost, getPosts, imageAttrs, socialImageUrl } from "../lib/sanity";
import { personRef } from "../lib/schema";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getPost(slug!);
if (!post) throw new Error(`Post not found: ${slug}`);

const others = (await getPosts()).filter((p) => p.slug !== post.slug).slice(0, 3);
const html = renderBody(post.body);
const cover = post.coverImage?.asset
  ? imageAttrs(post.coverImage, { widths: [640, 960, 1280, 1600] })
  : undefined;
const socialImage = post.coverImage?.asset
  ? socialImageUrl(post.coverImage)
  : undefined;
const url = new URL(`/${post.slug}/`, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  url,
  mainEntityOfPage: url,
  inLanguage: "es",
  ...(socialImage ? { image: socialImage } : {}),
  author: personRef(Astro.site),
};
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  image={socialImage}
  imageAlt={post.coverImage?.alt}
  type="article"
  publishedTime={post.publishedAt}
  modifiedTime={post.updatedAt}
  jsonLd={jsonLd}
  current="/miblog/"
>
  <article class="post">
    <header class="post-head">
      <p class="label">
        <a href="/miblog/">Mi blog</a>
        <span aria-hidden="true">·</span>
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
      </p>
      <h1>{post.title}</h1>
    </header>

    {
      cover && (
        <figure class="cover">
          <img
            src={cover.src}
            srcset={cover.srcset}
            sizes="(min-width: 64rem) 60rem, 100vw"
            width={cover.width}
            height={cover.height}
            alt={cover.alt}
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="prose" set:html={html} />

    <p class="back">
      <a class="arrow-link back" href="/miblog/">
        <span aria-hidden="true">←</span> Todas las entradas
      </a>
    </p>
  </article>

  {
    others.length > 0 && (
      <section class="more section panel" aria-labelledby="more-title">
        <h2 id="more-title" class="label">Sigue leyendo</h2>
        <ul class="posts">
          {others.map((other) => (
            <li>
              <PostCard post={other} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <BookSection headingLevel="p" />
</BaseLayout>

<style>
  .post {
    padding: clamp(3rem, 8vh, 5rem) var(--gutter) clamp(4rem, 10vh, 6rem);
  }

  .post-head {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .post-head .label {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.8rem;
  }

  .post-head .label a:hover {
    color: var(--accent-hover);
  }

  h1 {
    margin-top: 1.25rem;
    font: 500 clamp(2.3rem, 5.5vw, 3.75rem) / 1.08 var(--font-display);
    letter-spacing: 0.01em;
    text-wrap: balance;
    color: var(--ink);
  }

  .cover {
    display: flex;
    justify-content: center;
    max-width: 60rem;
    margin: clamp(2.5rem, 6vh, 3.5rem) auto 0;
  }

  /* Portrait images (a book cover) are kept to a sensible height. */
  .cover img {
    width: auto;
    max-height: min(75vh, 40rem);
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 1rem;
  }

  .prose {
    max-width: 42rem;
    margin: clamp(2.5rem, 6vh, 3.5rem) auto 0;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--ink);
  }

  .prose :global(> * + *) {
    margin-top: 1.25em;
  }

  .prose :global(p) {
    text-wrap: pretty;
  }

  .prose :global(:is(h2, h3, h4)) {
    margin-top: 2em;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.15;
    text-wrap: balance;
    color: var(--accent);
  }

  .prose :global(h2) {
    font-size: 2rem;
  }

  .prose :global(h3) {
    font-size: 1.65rem;
  }

  .prose :global(h4) {
    font-size: 1.35rem;
  }

  .prose :global(:is(h2, h3, h4) + *) {
    margin-top: 0.75em;
  }

  .prose :global(:is(ul, ol)) {
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: 0.6em;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .prose :global(a:hover) {
    color: var(--accent-hover);
  }

  .prose :global(blockquote) {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule-strong);
    font: italic 400 1.4rem / 1.4 var(--font-display);
  }

  .prose :global(.pt-image) {
    margin-block: 2.25em;
  }

  .prose :global(.pt-image img) {
    width: 100%;
    height: auto;
  }

  .prose :global(figcaption) {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .prose :global(.pt-video) {
    aspect-ratio: 16 / 9;
    margin-block: 2.25em;
  }

  .prose :global(.pt-video iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .back {
    max-width: 42rem;
    margin: 3.5rem auto 0;
  }

  .more .label {
    text-align: center;
  }

  .posts {
    display: grid;
    gap: 3rem clamp(1.5rem, 3vw, 2.75rem);
    max-width: 76rem;
    margin: 2.5rem auto 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
