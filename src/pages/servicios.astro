---
// Her individual support ("Acompañamiento" in the menu): what she works on,
// how the sessions go and what they cost. Brings together three pages of the
// old site: Temarios (the areas), Tu videoconferencia (the sessions are
// online) and Tarifas (the prices, in src/content/site.ts). Their old
// addresses redirect here (vercel.json), so the address stays /servicios/.
// The wording is hers, moved into the first person, with the duelo migratorio
// area taken from Mi historia. Her workshops for groups and companies are on
// /conferencias/.
import BaseLayout from "../layouts/BaseLayout.astro";
import { areas } from "../content/services";
import { sessions, site } from "../content/site";

const description =
  "Cómo acompaña Deissy Olarte: duelo migratorio, trauma y pérdida, familia, educación e integración social, en sesiones online individuales o en pareja. Tarifas y reserva.";
---

<BaseLayout title="Acompañamiento y tarifas" description={description} current="/servicios/">
  <section class="intro">
    <p class="label">Acompañamiento</p>
    <h1 class="title">Cómo te acompaño</h1>
    <p class="body-text">
      La resiliencia es la extraordinaria capacidad que todos tenemos de sobreponernos al dolor emocional y
      a las situaciones adversas: duelos, separaciones, infidelidad, traumas, bajas laborales, estrés,
      ansiedad, la enfermedad propia o la de otros. Ser resiliente es un conjunto de pensamientos,
      emociones y conductas que pueden aprenderse y desarrollarse. Para lograrlo hacen falta fuerza de
      voluntad y un buen apoyo emocional y profesional.
    </p>
  </section>

  <section class="areas section" aria-labelledby="areas-title">
    <h2 id="areas-title" class="visually-hidden">En qué te acompaño</h2>
    <ol class="area-grid">
      {
        areas.map((area, i) => (
          <li class="area" id={area.id}>
            <span class="number" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3>{area.title}</h3>
            <p>{area.text}</p>
            <ul>
              {area.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="tarifas" class="rates section panel" aria-labelledby="rates-title">
    <div class="rates-inner">
      <div class="rates-text">
        <p class="label">Sesiones y tarifas</p>
        <h2 id="rates-title" class="title">Por videoconferencia, desde cualquier lugar</h2>
        <p class="body-text">
          Las sesiones son online y en vivo: puedes conectarte desde cualquier país y huso horario. Pueden
          ser individuales, en pareja o en grupo.
        </p>
        <p class="body-text">
          Los talleres y las capacitaciones para grupos, centros educativos y empresas están en{" "}
          <a href="/conferencias/#formatos">Conferencias</a>, con un precio a la medida de cada encuentro.
        </p>
      </div>
      <dl class="prices">
        {
          sessions.prices.map((row) => (
            <div>
              <dt>{row.name}</dt>
              <dd>{row.price}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="reservar" class="book-session section" aria-labelledby="book-title">
    <p class="label">Reserva</p>
    <h2 id="book-title" class="book-title">Agenda tu videoconferencia</h2>
    <p class="body-text">
      Escríbeme por correo o por Instagram y acordamos el día y la hora. El pago de la consulta se hace por
      PayPal.
    </p>
    <ul class="actions">
      <li>
        <a class="button-primary" href={`mailto:${site.email}`}>
          Correo
          <span>{site.email}</span>
        </a>
      </li>
      <li>
        <a class="button-secondary" href={site.instagram.url} rel="noopener">
          Instagram
          <span>{site.instagram.handle}</span>
        </a>
      </li>
    </ul>
    <p class="pay">
      <a class="arrow-link" href={sessions.paypalUrl} rel="noopener">
        Pagar la consulta por PayPal <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(3.5rem, 9vh, 5.5rem) var(--gutter) clamp(3rem, 7vh, 4.5rem);
    text-align: center;
  }

  .intro .title {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }

  .intro .body-text {
    max-width: 62ch;
  }

  /* The areas */

  .area-grid {
    display: grid;
    gap: 3rem clamp(1.5rem, 3vw, 2.75rem);
    max-width: 76rem;
    margin-inline: auto;
    list-style: none;
  }

  @media (min-width: 44rem) {
    .area-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .area-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .area {
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-strong);
  }

  .number {
    font: 600 0.75rem / 1 var(--font-sans);
    letter-spacing: 0.2em;
    color: var(--detail);
  }

  .area h3 {
    margin-top: 0.9rem;
    font: italic 400 1.75rem / 1.15 var(--font-display);
    text-wrap: balance;
    color: var(--ink);
  }

  .area p {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--ink-soft);
  }

  .area ul {
    margin-top: 1.1rem;
    list-style: none;
  }

  .area li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--ink);
  }

  .area li + li {
    margin-top: 0.45rem;
  }

  .area li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 0.5rem;
    height: 1px;
    background: var(--accent);
  }

  /* Rates */

  .rates-inner {
    display: grid;
    gap: 3rem;
    max-width: 76rem;
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .rates-inner {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
    }
  }

  .prices {
    border-top: 1px solid var(--rule-strong);
  }

  .prices div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .prices dt {
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .prices dd {
    font: 500 1.9rem / 1 var(--font-display);
    color: var(--accent);
    white-space: nowrap;
  }

  /* Booking */

  .book-session {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .book-title {
    margin-top: 1rem;
    font: italic 400 clamp(2rem, 4vw, 2.75rem) / 1.15 var(--font-display);
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.25rem;
    list-style: none;
  }

  .actions a {
    min-width: 15rem;
  }

  .pay {
    margin-top: 2rem;
  }
</style>
